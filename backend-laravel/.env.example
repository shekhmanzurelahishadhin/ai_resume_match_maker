APP_NAME="Resume Matchmaker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# --- Frontend (Next.js) ---
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SESSION_DOMAIN=localhost

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=resumematchmaker
DB_USERNAME=root
DB_PASSWORD=

# --- Cache / Queue ---
CACHE_STORE=redis
CACHE_PREFIX=resumematchmaker_
QUEUE_CONNECTION=database
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# --- Redis ---
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Filesystem ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=resumematchmaker
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

# --- Mail (SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@resumematchmaker.local
MAIL_FROM_NAME="${APP_NAME}"

# --- AI provider ---
# Empty = auto: Groq if GROQ_API_KEY is set, else Hugging Face, else the
# deterministic fallback path. Pin explicitly with "groq" or "huggingface".
AI_PROVIDER=

# --- Groq (recommended) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Override if the default model id is retired — check what your key can reach:
# GET https://api.groq.com/openai/v1/models   (default: openai/gpt-oss-120b)
GROQ_MODEL=

# --- Hugging Face AI ---
# Used only when GROQ_API_KEY is unset (or AI_PROVIDER=huggingface).
HUGGINGFACE_API_KEY=
HUGGINGFACE_INFERENCE_ENDPOINT=https://api-inference.huggingface.co
HUGGINGFACE_TIMEOUT=30
HUGGINGFACE_RETRY_ATTEMPTS=3
HUGGINGFACE_RETRY_BASE_DELAY_MS=2000
AI_CACHE_TTL_SECONDS=604800

# --- Firebase Cloud Messaging (FCM) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Public (browser-side) config — surfaced via /api/notifications/firebase-config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# --- Admin ---
ADMIN_SECRET=

# --- Rate Limits (§8) ---
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_RESUME_UPLOAD_PER_HOUR=5
RATE_LIMIT_RESUME_GENERATE_PER_HOUR=10

# --- Resume upload constraints ---
RESUME_MAX_SIZE_KB=5120
