// Resume Matchmaker — Prisma Schema (all 4 phases)
// Maps onto the same MySQL database + tables created by the Laravel backend's
// migrations (snake_case tables/columns, UUID char(36) ids). Prisma model
// names/fields stay camelCase for ergonomic app code; @@map/@map bind them to
// the real Laravel-owned schema. Do NOT run `prisma migrate` against this —
// Laravel migrations are the source of truth for schema changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Phase 1: core ----------

model User {
  id           String    @id @db.Char(36) @default(uuid())
  name         String    @db.VarChar(255)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         String    @default("seeker") @db.VarChar(255) // 'seeker' | 'recruiter'
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)

  resumes            Resume[]
  jobPosts           JobPost[]
  matchesAsRecruiter Match[]
  generatedResumes   GeneratedResume[]
  deviceTokens       DeviceToken[]
  notifications      Notification[]
  notificationPrefs  NotificationPreference?

  @@index([email])
  @@map("users")
}

model Resume {
  id              String    @id @db.Char(36) @default(uuid())
  userId          String    @map("user_id") @db.Char(36)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName        String    @map("file_name") @db.VarChar(255)
  filePath        String    @map("file_path") @db.VarChar(255) // S3 key / local path
  mimeType        String    @map("mime_type") @db.VarChar(255)
  fileSizeBytes   Int       @map("file_size_bytes")
  extractedText   String?   @map("extracted_text") @db.LongText // populated after parsing
  skillsJson      Json?     @map("skills_json") // { skills: string[], categories: Record<string,string[]> }
  experienceYears Float?    @map("experience_years")
  status          String    @default("pending") @db.VarChar(255) // 'pending' | 'parsing' | 'ready' | 'failed'
  parseError      String?   @map("parse_error") @db.VarChar(255)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)

  matches          Match[]
  generatedResumes GeneratedResume[]
  improvements     ResumeImprovement[]

  @@index([userId])
  @@map("resumes")
}

model JobPost {
  id                 String    @id @db.Char(36) @default(uuid())
  recruiterId        String    @map("recruiter_id") @db.Char(36)
  recruiter          User      @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  title              String    @db.VarChar(255)
  description        String    @db.LongText
  requiredSkillsJson Json?     @map("required_skills_json") // { skills: string[] }
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)

  matches Match[]

  @@index([recruiterId])
  @@map("job_posts")
}

model Match {
  id                String    @id @db.Char(36) @default(uuid())
  resumeId          String    @map("resume_id") @db.Char(36)
  resume            Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobPostId         String    @map("job_post_id") @db.Char(36)
  jobPost           JobPost   @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  recruiterId       String    @map("recruiter_id") @db.Char(36)
  recruiter         User      @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  matchPercentage   Float     @default(0) @map("match_percentage")
  matchSource       String    @default("fallback") @map("match_source") @db.VarChar(255) // 'ai' | 'fallback'
  matchedSkillsJson Json?     @map("matched_skills_json") // { skills: string[] }
  missingSkillsJson Json?     @map("missing_skills_json") // { skills: string[] }
  analyzedAt        DateTime  @default(now()) @map("analyzed_at") @db.Timestamp(0)
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([resumeId])
  @@index([jobPostId])
  @@index([recruiterId])
  @@map("matches")
}

// ---------- Phase 2: resume generation ----------

model ResumeTemplate {
  id           String    @id @db.Char(36) @default(uuid())
  name         String    @db.VarChar(255)
  slug         String    @unique @db.VarChar(255) // 'modern-clean' | 'professional-classic' | 'creative' | 'executive' | 'technical' | 'academic'
  description  String    @db.VarChar(255)
  previewImage String?   @map("preview_image") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  generatedResumes GeneratedResume[]

  @@map("resume_templates")
}

model GeneratedResume {
  id                String    @id @db.Char(36) @default(uuid())
  userId            String    @map("user_id") @db.Char(36)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalResumeId  String?   @map("original_resume_id") @db.Char(36)
  originalResume    Resume?   @relation(fields: [originalResumeId], references: [id], onDelete: SetNull)
  templateId        String    @map("template_id") @db.Char(36)
  template          ResumeTemplate @relation(fields: [templateId], references: [id])
  contentJson       Json      @map("content_json") // structured resume content (contact, summary, experience, education, skills)
  customizationJson Json?     @map("customization_json") // colors, fonts, spacing
  filePathPdf       String?   @map("file_path_pdf") @db.VarChar(255)
  filePathDocx      String?   @map("file_path_docx") @db.VarChar(255)
  filePathHtml      String?   @map("file_path_html") @db.VarChar(255)
  version           Int       @default(1)
  isCurrent         Boolean   @default(true) @map("is_current")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)

  versions ResumeVersion[]

  @@index([userId])
  @@index([templateId])
  @@map("generated_resumes")
}

model ResumeVersion {
  id                String    @id @db.Char(36) @default(uuid())
  generatedResumeId String    @map("generated_resume_id") @db.Char(36)
  generatedResume   GeneratedResume @relation(fields: [generatedResumeId], references: [id], onDelete: Cascade)
  versionNumber     Int       @map("version_number")
  contentJson       Json      @map("content_json")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([generatedResumeId])
  @@map("resume_versions")
}

model ResumeImprovement {
  id             String    @id @db.Char(36) @default(uuid())
  resumeId       String    @map("resume_id") @db.Char(36)
  resume         Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  originalText   String    @map("original_text") @db.LongText
  improvedText   String    @map("improved_text") @db.LongText
  suggestionType String    @map("suggestion_type") @db.VarChar(255) // 'grammar' | 'style' | 'enhancement'
  source         String    @db.VarChar(255) // 'ai' | 'fallback'
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([resumeId])
  @@map("resume_improvements")
}

// ---------- Phase 3: notifications ----------

model DeviceToken {
  id          String    @id @db.Char(36) @default(uuid())
  userId      String    @map("user_id") @db.Char(36)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken String    @unique @map("device_token") @db.VarChar(255)
  deviceType  String    @map("device_type") @db.VarChar(255) // 'web' | 'ios' | 'android'
  browserInfo String?   @map("browser_info") @db.VarChar(255)
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime  @default(now()) @map("last_used_at") @db.Timestamp(0)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([userId])
  @@map("device_tokens")
}

model Notification {
  id        String    @id @db.Char(36) @default(uuid())
  userId    String    @map("user_id") @db.Char(36)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(255) // 'job_match' | 'resume_analysis' | 'new_job' | 'system' | 'daily_digest'
  title     String    @db.VarChar(255)
  body      String    @db.Text
  dataJson  Json?     @map("data_json")
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at") @db.Timestamp(0)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                 String    @id @db.Char(36) @default(uuid())
  userId             String    @unique @map("user_id") @db.Char(36)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications Boolean   @default(true) @map("email_notifications")
  pushNotifications  Boolean   @default(true) @map("push_notifications")
  jobMatches         Boolean   @default(true) @map("job_matches")
  resumeAnalysis     Boolean   @default(true) @map("resume_analysis")
  newJobs            Boolean   @default(true) @map("new_jobs")
  dailyDigest        Boolean   @default(false) @map("daily_digest")
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("notification_preferences")
}

// ---------- Supporting: rate limit + AI cache ----------

model RateLimitBucket {
  id        String    @id @db.Char(36) @default(uuid())
  key       String    @unique @db.VarChar(255) // e.g. 'resume_upload:user:<id>'
  count     Int       @default(0)
  windowEnd DateTime  @default(now()) @map("window_end") @db.Timestamp(0)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("rate_limit_buckets")
}

model AiCache {
  id        String    @id @db.Char(36) @default(uuid())
  cacheKey  String    @unique @map("cache_key") @db.VarChar(64) // md5(resumeText + jobText)
  result    Json     
  source    String    @db.VarChar(255) // 'ai' | 'fallback'
  expiresAt DateTime  @default(now()) @map("expires_at") @db.Timestamp(0)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([cacheKey])
  @@index([expiresAt])
  @@map("ai_caches")
}
