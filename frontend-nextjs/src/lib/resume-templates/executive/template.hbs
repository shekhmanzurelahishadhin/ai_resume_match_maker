{{! executive — compact dense, summary-first, slate accent, condensed line-height }}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>{{contact.name}} — Resume</title>
<style>
{{{baseCss}}}
:root {
  --rm-color-primary: {{meta.colors.primary}};
  --rm-color-accent: {{meta.colors.accent}};
  --rm-color-text: {{meta.colors.text}};
  --rm-font-heading: {{meta.fonts.heading}};
  --rm-font-body: {{meta.fonts.body}};
}
body { font-size: 12px; line-height: 1.4; }
.rm-page { padding: 32px 40px; }
.rm-name {
  font-size: 26px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  border-bottom: 3px solid {{meta.colors.primary}};
  padding-bottom: 6px;
  margin-bottom: 8px;
}
.rm-contact-links { font-size: 11px; }
.rm-section { margin-top: 16px; }
.rm-section-title {
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  border-bottom: 1px solid {{meta.colors.primary}};
  color: {{meta.colors.primary}};
  margin-bottom: 6px;
}
.rm-exp-item { margin-bottom: 8px; }
.rm-bullets { margin-top: 3px; }
.rm-summary p { font-size: 12px; color: #374151; }
</style>
</head>
<body>
<div class="rm-page">
  {{> contactHeader}}
  {{> summaryBlock}}
  {{> experienceList}}
  {{> educationList}}
  {{> skillsList}}
  {{> certificationsList}}
  {{> projectsList}}
</div>
</body>
</html>
