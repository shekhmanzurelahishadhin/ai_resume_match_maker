{{! modern-clean — single column, sans-serif, generous whitespace, emerald accent }}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>{{contact.name}} — Resume</title>
<style>
{{{baseCss}}}
:root {
  --rm-color-primary: {{meta.colors.primary}};
  --rm-color-accent: {{meta.colors.accent}};
  --rm-color-text: {{meta.colors.text}};
  --rm-font-heading: {{meta.fonts.heading}};
  --rm-font-body: {{meta.fonts.body}};
}
.rm-page { padding: 48px; }
.rm-name { font-size: 30px; }
.rm-section { margin-top: 26px; }
.rm-section-title { border-bottom: 1px solid {{meta.colors.primary}}; }
</style>
</head>
<body>
<div class="rm-page">
  {{> contactHeader}}
  {{> summaryBlock}}
  {{> experienceList}}
  {{> educationList}}
  {{> skillsList}}
  {{> projectsList}}
  {{> certificationsList}}
</div>
</body>
</html>
