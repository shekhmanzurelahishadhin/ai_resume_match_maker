# Resume Matchmaker — Docker build context ignore list.
#
# Keeps the build context small + prevents host state (node_modules, .next,
# .git, uploads, the local SQLite DB) from leaking into the image.

# Version control
.git
.gitignore
.gitattributes

# Dependencies (reinstalled inside the image)
node_modules
**/node_modules

# Next.js build output (rebuilt inside the image)
.next
out
build
dist

# Local databases (the docker-compose stack ships its own MySQL volume)
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm
db/test.db*

# Local uploads (the docker-compose stack ships its own uploads volume)
uploads
uploads-test

# Logs
*.log
dev.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / editor
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Env files (the container reads env vars from the orchestrator, not from
# build-time files)
.env
.env.local
.env.docker
.env.*.local

# Docs / scripts that aren't needed at runtime
docs
README.md
worklog.md
agent-ctx
tool-results
tests
vitest.config.ts

# Misc project files
download
skills
examples
