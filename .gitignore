# Resume Matchmaker — root ignore rules (frontend-nextjs + backend-laravel).
# Unanchored patterns apply recursively, so they cover both subprojects.
# Each subproject also keeps its own .gitignore for stack-specific extras.

# ---------- Secrets / environment ----------
.env
.env.*
!.env.example
auth.json
*.pem
*.key
/storage/*.key

# ---------- Dependencies ----------
node_modules/
vendor/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Build output ----------
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ---------- Generated code ----------
# Prisma client is regenerated by `prisma generate`.
.prisma/
frontend-nextjs/prisma/generated/

# ---------- Laravel runtime ----------
/backend-laravel/bootstrap/cache/*.php
/backend-laravel/public/hot
/backend-laravel/public/storage
/backend-laravel/storage/app/private
/backend-laravel/storage/app/public/resumes
/backend-laravel/storage/framework/cache/data/*
/backend-laravel/storage/framework/sessions/*
/backend-laravel/storage/framework/views/*
/backend-laravel/storage/logs/*
/backend-laravel/storage/framework/testing/
.phpunit.result.cache
.phpunit.cache/

# ---------- User uploads / local databases ----------
uploads/
*.sqlite
*.sqlite3
*.db

# ---------- Tests & coverage ----------
coverage/
.nyc_output/

# ---------- Logs ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Editors & tooling ----------
.idea/
.vscode/
.fleet/
.nova/
.claude/
.z-ai-config

# ---------- Deploy platforms ----------
.vercel

# ---------- OS cruft ----------
.DS_Store
Thumbs.db
desktop.ini
